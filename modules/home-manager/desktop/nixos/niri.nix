# Per-user niri session: config.kdl + the Noctalia shell user service.
#
# System side (session registration, portals, polkit, upower, fonts) lives in
# modules/configuration/nixos/niri.nix.
{
  lib,
  config,
  pkgs,
  ...
}: let
  noctalia = "${pkgs.noctalia-shell}/bin/noctalia-shell";
  ipc = target: fn: "spawn \"${noctalia}\" \"ipc\" \"call\" \"${target}\" \"${fn}\"";
in {
  # Noctalia keeps its own mutable state in ~/.config/noctalia/settings.json
  # (the settings panel writes to it), so it is deliberately not managed here.
  systemd.user.services.noctalia-shell = {
    Unit = {
      Description = "Noctalia desktop shell";
      PartOf = ["niri.service"];
      After = ["niri.service"];
    };
    Service = {
      ExecStart = noctalia;
      Restart = "on-failure";
      RestartSec = 1;
      Slice = "session.slice";
    };
    Install.WantedBy = ["niri.service"];
  };

  home.pointerCursor = {
    package = pkgs.adwaita-icon-theme;
    name = "Adwaita";
    size = 24;
    gtk.enable = true;
  };

  # Keep GTK apps dark to match Noctalia's default scheme.
  dconf.settings."org/gnome/desktop/interface".color-scheme = "prefer-dark";

  # niri reloads this file automatically when the symlink target changes.
  xdg.configFile."niri/config.kdl".text = ''
    // Generated by home-manager from
    // modules/home-manager/desktop/nixos/niri.nix -- edit that, not this file.
    // Reference: https://yalter.github.io/niri/

    input {
        keyboard {
            xkb {
                layout "us"
                // Same remap as services.xserver.xkb.options in the NixOS config.
                options "caps:swapescape"
            }
            repeat-delay 300
            repeat-rate 40
        }

        touchpad {
            tap
            dwt
            natural-scroll
            click-method "clickfinger"
            accel-profile "adaptive"
            scroll-factor 0.6
        }

        mouse {
            accel-profile "flat"
        }

        warp-mouse-to-focus
        focus-follows-mouse max-scroll-amount="0%"
    }

    // Framework 13 panel: 2256x1504. Scale 1.25 matches the fractional scale
    // used under GNOME.
    output "eDP-1" {
        mode "2256x1504@59.999"
        scale 1.25
    }

    // Philips 325E1, placed to the right of the laptop panel (eDP-1 is
    // 2256 / 1.25 = 1805 logical pixels wide).
    output "DP-1" {
        mode "2560x1440@59.951"
        scale 1.0
        position x=1805 y=0
    }

    layout {
        gaps 8
        center-focused-column "never"

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        default-column-width { proportion 0.5; }

        focus-ring {
            width 2
            active-color "#7aa2f7"
            inactive-color "#3b4261"
        }

        border {
            off
        }

        // Noctalia's bar sets its own exclusive zone, so no struts needed.
        struts {
        }
    }

    prefer-no-csd
    screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

    // niri starts xwayland-satellite on demand and exports DISPLAY to the
    // processes it spawns, so X11 clients just work.
    xwayland-satellite {
        path "${pkgs.xwayland-satellite}/bin/xwayland-satellite"
    }

    environment {
        NIXOS_OZONE_WL "1"
        ELECTRON_OZONE_PLATFORM_HINT "auto"
        MOZ_ENABLE_WAYLAND "1"
    }

    cursor {
        xcursor-theme "Adwaita"
        xcursor-size 24
    }

    hotkey-overlay {
        skip-at-startup
    }

    window-rule {
        geometry-corner-radius 8
        clip-to-geometry true
    }

    window-rule {
        match app-id="^1Password$"
        block-out-from "screencast"
    }

    window-rule {
        match title="^Picture-in-Picture$"
        open-floating true
    }

    binds {
        Mod+Shift+Slash { show-hotkey-overlay; }

        // Applications.
        Mod+Return hotkey-overlay-title="Terminal" { spawn "${pkgs.ghostty}/bin/ghostty"; }
        Mod+B hotkey-overlay-title="Browser" { spawn "${pkgs.firefox}/bin/firefox"; }
        Mod+E hotkey-overlay-title="Files" { spawn "${pkgs.nautilus}/bin/nautilus"; }

        // Noctalia shell.
        Mod+Space hotkey-overlay-title="Application launcher" { ${ipc "launcher" "toggle"}; }
        Mod+V hotkey-overlay-title="Clipboard history" { ${ipc "launcher" "clipboard"}; }
        Mod+Shift+E hotkey-overlay-title="Emoji picker" { ${ipc "launcher" "emoji"}; }
        Mod+C hotkey-overlay-title="Control center" { ${ipc "controlCenter" "toggle"}; }
        Mod+N hotkey-overlay-title="Notifications" { ${ipc "notifications" "toggleHistory"}; }
        Mod+Shift+N hotkey-overlay-title="Wifi / bluetooth" { ${ipc "network" "togglePanel"}; }
        Mod+Shift+B hotkey-overlay-title="Battery" { ${ipc "battery" "togglePanel"}; }
        Mod+Shift+C hotkey-overlay-title="Shell settings" { ${ipc "settings" "toggle"}; }
        Mod+Shift+D hotkey-overlay-title="Toggle dark mode" { ${ipc "darkMode" "toggle"}; }
        Mod+Shift+I hotkey-overlay-title="Toggle idle inhibitor" { ${ipc "idleInhibitor" "toggle"}; }
        Mod+Alt+L hotkey-overlay-title="Lock screen" { ${ipc "lockScreen" "lock"}; }
        Mod+Escape hotkey-overlay-title="Session menu" { ${ipc "sessionMenu" "toggle"}; }

        // Volume and brightness go through Noctalia so they show its OSD.
        XF86AudioRaiseVolume allow-when-locked=true { ${ipc "volume" "increase"}; }
        XF86AudioLowerVolume allow-when-locked=true { ${ipc "volume" "decrease"}; }
        XF86AudioMute        allow-when-locked=true { ${ipc "volume" "muteOutput"}; }
        XF86AudioMicMute     allow-when-locked=true { ${ipc "volume" "muteInput"}; }
        XF86MonBrightnessUp   allow-when-locked=true { ${ipc "brightness" "increase"}; }
        XF86MonBrightnessDown allow-when-locked=true { ${ipc "brightness" "decrease"}; }

        XF86AudioPlay allow-when-locked=true { spawn "${pkgs.playerctl}/bin/playerctl" "play-pause"; }
        XF86AudioNext allow-when-locked=true { spawn "${pkgs.playerctl}/bin/playerctl" "next"; }
        XF86AudioPrev allow-when-locked=true { spawn "${pkgs.playerctl}/bin/playerctl" "previous"; }

        // Windows and columns.
        Mod+Q { close-window; }
        Mod+H { focus-column-left; }
        Mod+L { focus-column-right; }
        Mod+J { focus-window-down; }
        Mod+K { focus-window-up; }
        Mod+Left  { focus-column-left; }
        Mod+Right { focus-column-right; }
        Mod+Down  { focus-window-down; }
        Mod+Up    { focus-window-up; }
        Mod+Home { focus-column-first; }
        Mod+End  { focus-column-last; }

        Mod+Ctrl+H { move-column-left; }
        Mod+Ctrl+L { move-column-right; }
        Mod+Ctrl+J { move-window-down; }
        Mod+Ctrl+K { move-window-up; }
        Mod+Ctrl+Left  { move-column-left; }
        Mod+Ctrl+Right { move-column-right; }
        Mod+Ctrl+Down  { move-window-down; }
        Mod+Ctrl+Up    { move-window-up; }

        Mod+Comma  { consume-window-into-column; }
        Mod+Period { expel-window-from-column; }
        Mod+BracketLeft  { consume-or-expel-window-left; }
        Mod+BracketRight { consume-or-expel-window-right; }

        Mod+R { switch-preset-column-width; }
        Mod+Shift+R { switch-preset-window-height; }
        Mod+F { maximize-column; }
        Mod+Shift+F { fullscreen-window; }
        Mod+Ctrl+F { expand-column-to-available-width; }
        Mod+T { toggle-column-tabbed-display; }
        Mod+Shift+Space { toggle-window-floating; }
        Mod+Ctrl+Space { switch-focus-between-floating-and-tiling; }
        Mod+Ctrl+C { center-column; }

        Mod+Minus { set-column-width "-10%"; }
        Mod+Equal { set-column-width "+10%"; }
        Mod+Shift+Minus { set-window-height "-10%"; }
        Mod+Shift+Equal { set-window-height "+10%"; }

        // Workspaces.
        Mod+Tab { toggle-overview; }
        Mod+U { focus-workspace-down; }
        Mod+I { focus-workspace-up; }
        Mod+Page_Down { focus-workspace-down; }
        Mod+Page_Up   { focus-workspace-up; }
        Mod+Ctrl+U { move-column-to-workspace-down; }
        Mod+Ctrl+I { move-column-to-workspace-up; }

        Mod+1 { focus-workspace 1; }
        Mod+2 { focus-workspace 2; }
        Mod+3 { focus-workspace 3; }
        Mod+4 { focus-workspace 4; }
        Mod+5 { focus-workspace 5; }
        Mod+6 { focus-workspace 6; }
        Mod+7 { focus-workspace 7; }
        Mod+8 { focus-workspace 8; }
        Mod+9 { focus-workspace 9; }
        Mod+Ctrl+1 { move-column-to-workspace 1; }
        Mod+Ctrl+2 { move-column-to-workspace 2; }
        Mod+Ctrl+3 { move-column-to-workspace 3; }
        Mod+Ctrl+4 { move-column-to-workspace 4; }
        Mod+Ctrl+5 { move-column-to-workspace 5; }
        Mod+Ctrl+6 { move-column-to-workspace 6; }
        Mod+Ctrl+7 { move-column-to-workspace 7; }
        Mod+Ctrl+8 { move-column-to-workspace 8; }
        Mod+Ctrl+9 { move-column-to-workspace 9; }

        Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
        Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
        Mod+WheelScrollRight     { focus-column-right; }
        Mod+WheelScrollLeft      { focus-column-left; }

        // Monitors.
        Mod+Shift+H { focus-monitor-left; }
        Mod+Shift+L { focus-monitor-right; }
        Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
        Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

        // Screenshots (niri's own picker; saved to screenshot-path above).
        Print { screenshot; }
        Ctrl+Print { screenshot-screen; }
        Alt+Print { screenshot-window; }

        Mod+Shift+P { power-off-monitors; }
        Mod+Shift+Escape { quit; }
    }
  '';
}
